# === Brabo Tabacos — front (Next.js) ===
# Copiá a .env.local (dev) o .env.production (build VPS/Vercel).

# Local (API Brabo en :8088)
NEXT_PUBLIC_API_URL=http://localhost:8088/api/

# Prod aurixerp.com (descomentar al build de producción):
# NEXT_PUBLIC_API_URL=https://api-brabo.aurixerp.com/api/
# NEXT_PUBLIC_BASE_URL=https://brabo.aurixerp.com

NEXT_PUBLIC_APP_NAME=Brabo Tabacos
NEXT_PUBLIC_COMPANY_NAME=Brabo Tabacos
NEXT_PUBLIC_COMPANY_LEGAL_NAME=Brabo Tabacos
NEXT_PUBLIC_COMPANY_TAGLINE=Cigarrillos, golosinas y medicamentos
NEXT_PUBLIC_COMPANY_EMAIL=admin@brabotabacos.local
# NEXT_PUBLIC_COMPANY_ADDRESS=
# NEXT_PUBLIC_COMPANY_CITY=
# NEXT_PUBLIC_COMPANY_CUIT=
# Factura ARCA (opcionales; si faltan usa COMPANY_*):
# NEXT_PUBLIC_FACTURADOR_RAZON_SOCIAL=
# NEXT_PUBLIC_FACTURADOR_DOMICILIO=
# NEXT_PUBLIC_FACTURADOR_CUIT_EMISOR=

# Logos (rutas bajo /public)
NEXT_PUBLIC_LOGO_MARK_PATH=/images/brabo-logo.png
NEXT_PUBLIC_LOGO_FULL_PATH=/images/brabo-logo.png
NEXT_PUBLIC_POWERED_BY_LOGO_PATH=/images/aurix-logo.png

# Feature flags (retail simple: reparaciones off)
NEXT_PUBLIC_FEATURE_REPARACIONES=false
NEXT_PUBLIC_FEATURE_WOOCOMMERCE=false
NEXT_PUBLIC_FEATURE_TIENDA=false

# VPS: next start -H 127.0.0.1 -p 3088 (nginx brabo.aurixerp.com → :3088)
# NEXT_PUBLIC_POS_API_KEY=
